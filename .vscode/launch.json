{
    // Use o IntelliSense para saber mais sobre os atributos possíveis.
    // Focalizar para exibir as descrições dos atributos existentes.
    // Para obter mais informações, acesse: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OCR Test",
            "type": "debugpy",
            "request": "launch",
            "module": "tests.test_ocr",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
        },
        {
            "name": "Indexing Test",
            "type": "debugpy",
            "request": "launch",
            "module": "tests.test_index",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "env": {
                "LLM_N_GPU_LAYERS": "40",
            }
        },
        {
            "name": "Index Search Test",
            "type": "debugpy",
            "request": "launch",
            "module": "tests.test_search",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
        },
        {
            "name": "LLM Test",
            "type": "debugpy",
            "request": "launch",
            "module": "tests.test_llm",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "env": {
                "LLM_N_GPU_LAYERS": "40",
            }
        },
        {
            "name": "Debug Django",
            "type": "debugpy",
            "request": "launch",
            "module": "django",
            "args": [
                "runserver",
                "127.0.0.1:8000"
            ],
            "jinja": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "core.settings",
                "LLM_N_GPU_LAYERS": "40"
            },
            "django": true,
            "justMyCode": true
        },
        {
            "name": "Debug Django Command: process_documents",
            "type": "debugpy",
            "request": "launch",
            "module": "django",
            "args": [
                "process_documents",
                "data/raw/email"
            ],
            "jinja": true,
            "django": true,
            "console": "integratedTerminal",
            "env": {
                "DJANGO_SETTINGS_MODULE": "core.settings",
                "LLM_N_GPU_LAYERS": "40"
            },
            "justMyCode": true
        }
    ]
}